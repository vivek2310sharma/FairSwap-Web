# FairSwap.in - Local Environment Configuration Example
# Copy to .env.local for local development. Do not commit actual secrets to version control.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_local_anon_key_for_testing
# Legacy local anon key alias compatibility:
NEXT_PUBLIC_SUPABASE_ANON_KEY=sbp_local_anon_key_for_testing

# Server-only service role secret key (strictly for local bootstrap script and test teardown):
SUPABASE_SECRET_KEY=sbp_local_service_role_key_for_testing
SUPABASE_SERVICE_ROLE_KEY=sbp_local_service_role_key_for_testing

# Resend delivery-event monitoring (server-only; configure per environment).
# Never commit the real signing secret or alert webhook URL.
RESEND_WEBHOOK_SECRET=
OPERATIONS_ALERT_WEBHOOK_URL=
