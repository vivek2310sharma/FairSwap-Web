# FairSwap.in - Local Environment Configuration Example
# Copy to .env.local for local development. Do not commit actual secrets to version control.
#
# Production (Vercel) must set:
# NEXT_PUBLIC_SITE_URL=https://fairswap.in
# This exact production URL enables indexing. Local, staging, and preview deployments remain noindex.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_local_anon_key_for_testing
# Legacy local anon key alias compatibility:
NEXT_PUBLIC_SUPABASE_ANON_KEY=sbp_local_anon_key_for_testing

# Server-only service role secret key (strictly for local bootstrap script and test teardown):
SUPABASE_SECRET_KEY=sbp_local_service_role_key_for_testing
SUPABASE_SERVICE_ROLE_KEY=sbp_local_service_role_key_for_testing

# Resend delivery-event monitoring (server-only; configure per environment).
# Never commit the real signing secret or alert webhook URL.
RESEND_WEBHOOK_SECRET=
OPERATIONS_ALERT_WEBHOOK_URL=

# Listing email outbox worker / Supabase Edge Function (server-only; configure in Supabase dashboard / secrets).
# Never commit real provider API keys or worker secrets.
# Remote Edge Function environments must override SITE_URL explicitly (no runtime fallback):
# FairSwapTest -> staging application origin (e.g. https://fair-swap-git-staging-fairswap.vercel.app)
# FairSwapProd -> https://fairswap.in
SITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=FairSwap <notifications@fairswap.in>
EMAIL_WORKER_SECRET=

