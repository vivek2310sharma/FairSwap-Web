    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "sharp": "^0.35.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "4.19.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
