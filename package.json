    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "location:import": "tsx scripts/import-india-postal-data.ts",
    "preview:post-ad": "node tools/post-ad-preview/verify-imports.mjs && next dev tools/post-ad-preview --webpack --hostname 127.0.0.1 --port 4317",
